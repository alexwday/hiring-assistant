# Base RBC LLM framework environment example.
# Copy to .env locally and fill in secrets. Do not commit real secrets.

# Authentication: local uses OPENAI_API_KEY/API_KEY; oauth uses OAUTH_*.
AUTH_MODE=local
OPENAI_API_KEY=

# OAuth settings, required only when AUTH_MODE=oauth.
OAUTH_ENDPOINT=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_GRANT_TYPE=client_credentials
OAUTH_SCOPE=
OAUTH_MAX_RETRIES=3
OAUTH_RETRY_DELAY_SECONDS=1.0
OAUTH_TIMEOUT_SECONDS=30.0

# PostgreSQL prompts table.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=public

# OpenAI-compatible endpoint and model settings.
LLM_BASE_URL=https://api.openai.com/v1

# Small model profile. The hiring assistant uses this for resume vision and review.
LLM_MODEL_SMALL=gpt-5.4-mini
LLM_MAX_TOKENS_SMALL=32768
LLM_TIMEOUT_SECONDS_SMALL=60.0
LLM_MAX_RETRIES_SMALL=2
LLM_REASONING_EFFORT_SMALL=

# Large model profile. Prompts select this with model_size: large.
LLM_MODEL_LARGE=gpt-5.4
LLM_MAX_TOKENS_LARGE=32768
LLM_TIMEOUT_SECONDS_LARGE=120.0
LLM_MAX_RETRIES_LARGE=2
LLM_REASONING_EFFORT_LARGE=

# SSL: enable for RBC/internal environments. When true, the framework tries
# rbc_security.enable_certs() if available and otherwise warns before using
# system certificates.
SSL_VERIFY=false

# Conversation and logging.
INCLUDE_SYSTEM_MESSAGES=true
ALLOWED_ROLES=system,user,assistant
MAX_HISTORY_LENGTH=20
LOG_LEVEL=INFO
OUTPUT_LOGS=false

# Local web app settings.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DATA_DIR=data
APP_OPEN_BROWSER=true
APP_RESET_DATA_ON_STARTUP=false

# LLM concurrency. Defaults are tuned for a heavier enterprise plan while
# keeping one global cap across processing, review, and final rerank calls.
APP_MAX_PARALLEL_LLM_CALLS=8
APP_PROCESS_WORKERS=8
APP_REVIEW_WORKERS=8
APP_PAGE_WORKERS=8
